# Anthropic API configuration for the renewal-risk pipeline.
# -----------------------------------------------------------

# Required: Anthropic API key (starts with sk-ant-…). Either name works.
ANTHROPIC_API_KEY=your-anthropic-api-key
# API_KEY=your-anthropic-api-key   # legacy alias also accepted

# Required: model id. Recommended:
#   claude-haiku-4-5-20251001  — fastest, cheapest (~$0.013 / customer)
#   claude-sonnet-4-6          — better synthesis (~$0.040 / customer)
#   claude-opus-4-7            — most capable (most expensive)
MODEL_ID=claude-haiku-4-5-20251001
