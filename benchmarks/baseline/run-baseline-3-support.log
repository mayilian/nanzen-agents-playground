  from datetime import datetime                                                 
  from collections import defaultdict                                           
  import statistics                                                             
                                                                                
  # Calculate resolution times for resolved tickets                             
  resolved_tickets = []                                                         
  open_tickets = []                                                             
                                                                                
  for ticket_id, ticket in tickets_data.items():                                
      if ticket['created_timestamp'] and ticket['resolved_timestamp']:          
          try:                                                                  
              created = datetime.strptime(ticket['created_timestamp'],          
  '%Y-%m-%d %H:%M:%S')                                                          
              resolved = datetime.strptime(ticket['resolved_timestamp'],        
  '%Y-%m-%d %H:%M:%S')                                                          
              resolution_hours = (resolved - created).total_seconds() / 3600    
              ticket['resolution_hours'] = round(resolution_hours, 1)           
              resolved_tickets.append(ticket)                                   
          except:                                                               
              pass                                                              
      elif ticket['ticket_status'] == 'open':                                   
          open_tickets.append(ticket)                                           
                                                                                
  print(f"Resolved tickets: {len(resolved_tickets)}")                           
  print(f"Open tickets: {len(open_tickets)}")                                   
                                                                                
  # Analyze by category                                                         
  category_stats = defaultdict(lambda: {'count': 0, 'tickets': []})             
  for ticket in list(resolved_tickets) + list(open_tickets):                    
      cat = ticket['category'] if ticket['category'] else 'Uncategorized'       
      category_stats[cat]['count'] += 1                                         
      category_stats[cat]['tickets'].append(ticket['ticket_id'])                
                                                                                
  print("\n=== TICKETS BY CATEGORY ===")                                        
  for cat, stats in sorted(category_stats.items(), key=lambda x:                
  x[1]['count'], reverse=True):                                                 
      print(f"{cat}: {stats['count']} tickets")                                 
                                                                                
  # Analyze by priority                                                         
  priority_stats = defaultdict(lambda: {'count': 0, 'tickets': []})             
  for ticket in list(resolved_tickets) + list(open_tickets):                    
      pri = ticket['priority'] if ticket['priority'] else 'not_set'             
      priority_stats[pri]['count'] += 1                                         
      priority_stats[pri]['tickets'].append(ticket['ticket_id'])                
                                                                                
  print("\n=== TICKETS BY PRIORITY ===")                                        
  for pri, stats in sorted(priority_stats.items()):                             
      print(f"{pri}: {stats['count']} tickets")                                 
                                                                                
  # Resolution time statistics                                                  
  if resolved_tickets:                                                          
      resolution_times = [t['resolution_hours'] for t in resolved_tickets]      
      avg_resolution = statistics.mean(resolution_times)                        
      median_resolution = statistics.median(resolution_times)                   
      print(f"\n=== RESOLUTION TIME ANALYSIS ===")                              
      print(f"Average resolution time: {avg_resolution:.1f} hours")             
      print(f"Median resolution time: {median_resolution:.1f} hours")           
      print(f"Fastest: {min(resolution_times):.1f} hours")                      
      print(f"Slowest: {max(resolution_times):.1f} hours")                      
                                                                                
  # Satisfaction scores                                                         
  satisfaction_scores = []                                                      
  for ticket in list(resolved_tickets) + list(open_tickets):                    
      if ticket['satisfaction_score']:                                          
          try:                                                                  
              satisfaction_scores.append(int(ticket['satisfaction_score']))     
          except:                                                               
              pass                                                              
                                                                                
  if satisfaction_scores:                                                       
      avg_satisfaction = statistics.mean(satisfaction_scores)                   
      print(f"\n=== SATISFACTION SCORES ===")                                   
      print(f"Average satisfaction: {avg_satisfaction:.1f}/5")                  
      print(f"Response count: {len(satisfaction_scores)} surveys")              
      print(f"Score distribution:")                                             
      for score in sorted(set(satisfaction_scores)):                            
          count = satisfaction_scores.count(score)                              
          print(f"  {score} stars: {count}")                                    
                                                                                
  # Identify recurring issues                                                   
  print("\n=== TOP ISSUES (BY TAG) ===")                                        
  tag_counts = defaultdict(int)                                                 
  for ticket in list(resolved_tickets) + list(open_tickets):                    
      if ticket['tags']:                                                        
          tags = [t.strip() for t in ticket['tags'].split(',')]                 
          for tag in tags:                                                      
              tag_counts[tag] += 1                                              
                                                                                
  for tag, count in sorted(tag_counts.items(), key=lambda x: x[1],              
  reverse=True)[:10]:                                                           
      print(f"  {tag}: {count} occurrences")                                    
